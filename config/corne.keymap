// Miryoku Colemak-DH for Chocofi (36-key Corne)
// Outer columns (&none) are not physically present on the Chocofi

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NAV   1
#define SYM   2
#define NUM   3
#define FUN   4
#define MEDIA 5

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Shift combos — faster than home row mod hold

        combo_lshift {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LSHFT>;
        };

        combo_rshift {
            timeout-ms = <50>;
            key-positions = <18 19>;
            bindings = <&kp RSHFT>;
        };

        // Bracket combos — vertical (top row + home row), left hand

        combo_lbrace {
            timeout-ms = <50>;
            key-positions = <2 14>;
            bindings = <&kp LBRC>;
        };

        combo_lbkt {
            timeout-ms = <50>;
            key-positions = <3 15>;
            bindings = <&kp LBKT>;
        };

        combo_lpar {
            timeout-ms = <50>;
            key-positions = <4 16>;
            bindings = <&kp LPAR>;
        };

        // Bracket combos — vertical (top row + home row), right hand

        combo_rpar {
            timeout-ms = <50>;
            key-positions = <7 19>;
            bindings = <&kp RPAR>;
        };

        combo_rbkt {
            timeout-ms = <50>;
            key-positions = <8 20>;
            bindings = <&kp RBKT>;
        };

        combo_rbrace {
            timeout-ms = <50>;
            key-positions = <9 21>;
            bindings = <&kp RBRC>;
        };

        combo_lshift_two {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <16 37>;
        };

        combo_rshift_two {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <19 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ──────────────────────────────────────────────────────────────────────
        // BASE — Colemak-DH
        // Left  home row: A=GUI  R=Alt  S=Ctrl  T=Shift
        // Right home row: N=Shift  E=Ctrl  I=Alt  O=GUI
        // Left  thumbs (outer→inner): Esc(Media)  Space(Nav)  Tab(Mouse)
        // Right thumbs (inner→outer): Enter(Sym)  Bksp(Num)  Del(Fun)
        // ──────────────────────────────────────────────────────────────────────

        base_layer {
            bindings = <
&none  &kp Q       &kp W       &kp F               &kp P             &kp B        &kp J        &kp L         &kp U        &kp Y       &kp SQT     &none
&none  &hm LGUI A  &hm LALT R  &hm LEFT_CONTROL S  &hm LEFT_SHIFT T  &kp G        &kp M        &hm RSHFT N   &hm RCTRL E  &hm RALT I  &hm RGUI O  &none
&none  &kp Z       &kp X       &kp C               &kp D             &kp V        &kp K        &kp H         &kp COMMA    &kp DOT     &kp FSLH    &none
                               &lt MEDIA ESC       &lt NAV SPACE     &lt 6 TAB    &lt 2 ENTER  &lt NUM BSPC  &lt FUN DEL
            >;
        };

        // ──────────────────────────────────────────────────────────────────────
        // NAV — Navigation (hold Space)
        // Right: arrow cluster + page/home/end
        // Left:  modifiers + macOS clipboard
        // ──────────────────────────────────────────────────────────────────────

        nav_layer {
            bindings = <
&none  &trans    &trans    &trans            &trans          &trans    &kp PG_UP  &kp HOME  &none     &kp END       &kp INS    &none
&none  &kp LGUI  &kp LALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans    &kp PG_DN  &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &none
&none  &none     &none     &none             &none           &none     &trans     &trans    &trans    &trans        &trans     &none
                           &trans            &trans          &trans    &kp RET    &kp BSPC  &kp DEL
            >;
        };

        // ──────────────────────────────────────────────────────────────────────
        // SYM — Symbols (hold Enter)
        // Left:  symbols (shifted Num equivalents)
        // Right: modifiers
        // Thumbs: ( ) _
        // ──────────────────────────────────────────────────────────────────────

        sym_layer {
            bindings = <
&none  &kp LBRC   &kp AMPS  &kp ASTRK  &kp LPAR   &kp RBRC     &trans  &trans     &trans     &trans    &trans    &none
&none  &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS     &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&none  &kp TILDE  &kp EXCL  &kp AT     &kp HASH   &kp PIPE     &trans  &trans     &trans     &trans    &trans    &none
                            &kp LPAR   &kp RPAR   &kp UNDER    &trans  &trans     &trans
            >;
        };

        // ──────────────────────────────────────────────────────────────────────
        // NUM — Numbers (hold Backspace)
        // Left:  numpad layout
        // Right: modifiers
        // Thumbs: . 0 -
        // ──────────────────────────────────────────────────────────────────────

        num_layer {
            bindings = <
&none  &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT     &trans  &trans     &trans     &trans    &trans    &none
&none  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&none  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH     &trans  &trans     &trans     &trans    &trans    &none
                          &kp DOT  &kp N0  &kp MINUS    &trans  &trans     &trans
            >;
        };

        // ──────────────────────────────────────────────────────────────────────
        // FUN — Function keys (hold Delete)
        // Left:  F-keys (mirrors Num positions)
        // Right: modifiers
        // ──────────────────────────────────────────────────────────────────────

        fun_layer {
            bindings = <
&none  &kp F12  &kp F7  &kp F8     &kp F9     &kp PSCRN          &trans  &trans     &trans     &trans    &trans    &none
&none  &kp F11  &kp F4  &kp F5     &kp F6     &kp SLCK           &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&none  &kp F10  &kp F1  &kp F2     &kp F3     &kp PAUSE_BREAK    &trans  &trans     &trans     &trans    &trans    &none
                        &kp K_APP  &kp SPACE  &kp TAB            &trans  &trans     &trans
            >;
        };

        // ──────────────────────────────────────────────────────────────────────
        // MEDIA — Media + Bluetooth (hold Esc)
        // Right home: prev / vol-dn / vol-up / next
        // Right bottom: BT profiles 0–3 + BT clear
        // Thumbs: stop  play/pause  mute
        // ──────────────────────────────────────────────────────────────────────

        media_layer {
            bindings = <
&none  &trans    &trans    &trans            &trans          &trans    &trans        &trans          &trans        &trans           &trans      &none
&none  &kp LGUI  &kp LALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans    &none         &kp C_PREVIOUS  &kp C_VOL_DN  &kp C_VOLUME_UP  &kp C_NEXT  &none
&none  &trans    &trans    &trans            &trans          &trans    &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3     &bt BT_CLR  &none
                           &trans            &trans          &trans    &kp C_STOP    &kp C_PP        &kp C_MUTE
            >;
        };

        mouse_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans          &trans          &trans        &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                        &trans  &trans  &trans    &mkp RCLK  &mkp LCLK       &trans
            >;
        };
    };
};
