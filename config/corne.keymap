#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// Layer indices
#define BASE  0
#define NAV   1
#define SYM   2
#define NUM   3
#define FUN   4
#define MEDIA 5

/ {
    behaviors {
        // Home row mod-tap: hold = modifier, tap = key
        // tap-preferred means short holds still register as taps while typing
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ─────────────────────────────────────────────────────────────────
        // BASE — Colemak-DH
        // Home row: GACS on left (GUI/Alt/Ctrl/Shift), SCAG mirrored right
        // Thumbs: Media/Nav/Esc | Ret/Num/Fun
        // ─────────────────────────────────────────────────────────────────
        base_layer {
            bindings = <
&none  &kp Q       &kp W       &kp F        &kp P        &kp B          &kp J    &kp L        &kp U        &kp Y       &kp SEMI    &none
&none  &hm LGUI A  &hm LALT R  &hm LSHFT S  &hm LCTRL T  &kp G          &kp M    &hm RCTRL N  &hm RSHFT E  &hm RALT I  &hm RGUI O  &none
&none  &kp Z       &kp X       &kp C        &kp D        &kp V          &kp K    &kp H        &kp COMMA    &kp DOT     &kp FSLH    &none
                         &lt MEDIA TAB  &lt NAV SPACE  &kp ESC          &kp RET  &lt NUM BKSP  &lt FUN DEL
            >;
        };

        // ─────────────────────────────────────────────────────────────────
        // NAV — Navigation (hold left-middle thumb / Space)
        // Right hand: arrow cluster + page/home/end
        // Left hand: modifiers + macOS undo/cut/copy/paste/redo
        // ─────────────────────────────────────────────────────────────────
        nav_layer {
            bindings = <
&none  &trans      &trans      &trans       &trans       &trans         &kp PG_UP  &kp HOME  &kp UP    &kp END    &kp INS   &none
&none  &kp LGUI    &kp LALT    &kp LSHFT    &kp LCTRL    &trans         &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL   &none
&none  &kp LG(Z)   &kp LG(X)   &kp LG(C)    &kp LG(V)    &kp LG(Y)      &trans     &trans    &trans    &trans     &trans    &none
                                    &trans  &trans  &trans               &kp RET   &kp BSPC  &kp DEL
            >;
        };

        // ─────────────────────────────────────────────────────────────────
        // SYM — Symbols (hold right-inner thumb / Ret)
        // Left hand: symbols, mirroring the Num layer logic
        // Right hand: mirrored modifiers
        // ─────────────────────────────────────────────────────────────────
        sym_layer {
            bindings = <
&none  &kp LBRC   &kp AMPS   &kp ASTRK   &kp LPAR    &kp RBRC       &trans  &trans     &trans     &trans    &trans    &none
&none  &kp COLON  &kp DLLR   &kp PRCNT   &kp CARET   &kp PLUS       &trans  &kp RCTRL  &kp RSHFT  &kp RALT  &kp RGUI  &none
&none  &kp TILDE  &kp EXCL   &kp AT      &kp HASH    &kp PIPE       &trans  &trans     &trans     &trans    &trans    &none
                                 &kp LPAR  &kp RPAR  &kp UNDER       &trans  &trans     &trans
            >;
        };

        // ─────────────────────────────────────────────────────────────────
        // NUM — Numbers (hold right-middle thumb / Backspace)
        // Left hand: numpad-style layout
        // Right hand: mirrored modifiers
        // ─────────────────────────────────────────────────────────────────
        num_layer {
            bindings = <
&none  &kp LBKT   &kp N7  &kp N8  &kp N9  &kp RBKT       &trans  &trans     &trans     &trans    &trans    &none
&none  &kp SEMI   &kp N4  &kp N5  &kp N6  &kp EQUAL      &trans  &kp RCTRL  &kp RSHFT  &kp RALT  &kp RGUI  &none
&none  &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp BSLH       &trans  &trans     &trans     &trans    &trans    &none
                              &kp DOT  &kp N0  &kp MINUS   &trans  &trans     &trans
            >;
        };

        // ─────────────────────────────────────────────────────────────────
        // FUN — Function keys (hold right-outer thumb / Delete)
        // Left hand: F-key numpad layout
        // Right hand: mirrored modifiers
        // ─────────────────────────────────────────────────────────────────
        fun_layer {
            bindings = <
&none  &kp F12  &kp F7  &kp F8  &kp F9  &kp PSCRN          &trans  &trans     &trans     &trans    &trans    &none
&none  &kp F11  &kp F4  &kp F5  &kp F6  &kp SLCK           &trans  &kp RCTRL  &kp RSHFT  &kp RALT  &kp RGUI  &none
&none  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK    &trans  &trans     &trans     &trans    &trans    &none
                          &kp K_APP  &kp SPACE  &kp TAB      &trans  &trans     &trans
            >;
        };

        // ─────────────────────────────────────────────────────────────────
        // MEDIA — Media + Bluetooth (hold left-outer thumb / Tab)
        // Right hand: media controls
        // Bottom-right: BT profile switching + clear
        // ─────────────────────────────────────────────────────────────────
        media_layer {
            bindings = <
&none  &trans    &trans    &trans     &trans     &trans         &trans        &trans        &trans        &trans        &trans      &none
&none  &kp LGUI  &kp LALT  &kp LSHFT  &kp LCTRL  &trans         &kp C_PREV    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT    &trans      &none
&none  &trans    &trans    &trans     &trans     &trans         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR  &none
                                  &trans  &trans  &trans         &kp C_STOP    &kp C_PP      &kp C_MUTE
            >;
        };
    };
};
